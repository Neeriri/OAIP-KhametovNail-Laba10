<Window x:Class="Laba10_1.recovery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Восстановление пароля" Height="350" Width="400">
    <StackPanel Margin="20">
        <TextBox x:Name="EmailTB" Tag="Email для восстановления" Margin="5" Height="30"/>
        <Button Content="Отправить код" Click="SendCodeButton_Click" Margin="5" Height="35"/>
        <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="5">
            <TextBox x:Name="CodeTB" Tag="Введите код" Margin="5" Height="30"/>
            <Button Content="Подтвердить" Click="VerifyCodeButton_Click" Margin="5" Height="35"/>
        </StackPanel>
    </StackPanel>
</Window>