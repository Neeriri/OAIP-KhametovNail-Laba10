<Window x:Class="Laba10_1.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="650" Width="450">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Имя:" Margin="5,10,5,2" FontWeight="Bold"/>
            <TextBox x:Name="FirstNameTB" Margin="5" Height="25"/>

            <TextBlock Text="Фамилия:" Margin="5,10,5,2" FontWeight="Bold"/>
            <TextBox x:Name="LastNameTB" Margin="5" Height="25"/>

            <TextBlock Text="Дата рождения (дд.мм.гггг):" Margin="5,10,5,2" FontWeight="Bold"/>
            <TextBox x:Name="DOBPicker" Margin="5" Height="25"/>

            <TextBlock Text="Email:" Margin="5,10,5,2" FontWeight="Bold"/>
            <TextBox x:Name="EmailTB" Margin="5" Height="25"/>

            <TextBlock Text="Пароль:" Margin="5,10,5,2" FontWeight="Bold"/>
            <PasswordBox x:Name="PasswordBox" Margin="5" Height="25"/>

            <TextBlock Text="Телефон:" Margin="5,10,5,2" FontWeight="Bold"/>
            <TextBox x:Name="PhoneTB" Margin="5" Height="25"/>

            <CheckBox x:Name="AdminCheckBox" Content="Роль администратора" Margin="5,10,5,2" Height="25"/>

            <TextBlock Text="Область исследования:" Margin="5,10,5,2" FontWeight="Bold"/>
            <TextBox x:Name="ResearchFieldTB" Margin="5" Height="25"/>

            <TextBlock Text="Дата первой публикации (дд.мм.гггг):" Margin="5,10,5,2" FontWeight="Bold"/>
            <TextBox x:Name="PubDatePicker" Margin="5" Height="25"/>

            <Button Content="Зарегистрироваться" Click="RegisterButton_Click" Margin="10,20,10,10" Height="35" FontWeight="Bold"/>
        </StackPanel>
    </ScrollViewer>
</Window>