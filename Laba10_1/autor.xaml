<Window x:Class="Laba10_1.autor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="300" Width="400">
    <StackPanel Margin="20">
        <TextBox x:Name="EmailTB" Tag="Email" Margin="5" Height="30"/>
        <PasswordBox x:Name="PasswordBox" Tag="Пароль" Margin="5" Height="30"/>
        <Button Content="Войти" Click="LoginButton_Click" Margin="5" Height="35"/>
        <Button Content="Забыли пароль?" Click="RecoverButton_Click" Margin="5" Height="30"/>
    </StackPanel>
</Window>