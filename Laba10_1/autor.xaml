<Window x:Class="Laba10_1.autor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="400" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Авторизация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Email:" Margin="5,10,5,2" FontWeight="Bold"/>
        <TextBox x:Name="EmailTB" Margin="5" Height="30"/>

        <TextBlock Text="Пароль:" Margin="5,10,5,2" FontWeight="Bold"/>
        <PasswordBox x:Name="PasswordBox" Margin="5" Height="30"/>

        <Button Content="Войти" Click="LoginButton_Click" Margin="5,20,5,10" Height="35" FontWeight="Bold"/>
        <Button Content="Забыли пароль?" Click="RecoverButton_Click" Margin="5" Height="30"/>
        <Button Content="Регистрация" Click="RegisterButton_Click" Margin="5" Height="30"/>
    </StackPanel>
</Window>