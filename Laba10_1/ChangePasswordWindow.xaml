<Window x:Class="Laba10_1.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" Height="250" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Введите новый пароль:" Margin="5"/>
        <PasswordBox x:Name="NewPasswordBox" Tag="Новый пароль" Margin="5" Height="30"/>
        <TextBlock Text="Подтвердите пароль:" Margin="5"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Tag="Подтверждение пароля" Margin="5" Height="30"/>
        <Button Content="Изменить пароль" Click="ChangePasswordButton_Click" Margin="5" Height="35"/>
    </StackPanel>
</Window>
